<Window x:Class="_2Modul.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2Modul"
        mc:Ignorable="d"
        Title="Учет партнеров" Height="600" Width="850"
        Icon="Images/Мастер пол.ico"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Image Source="Images/Мастер пол.png" Width="50" Height="50" Margin="0,0,15,0"/>
            <TextBlock Text="Список партнеров" FontSize="22"  VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="PartnersListView" 
                  Grid.Row="1" 
                  HorizontalContentAlignment="Stretch" 
                  BorderBrush="Black" 
                  BorderThickness="1"
                  MouseDoubleClick="PartnersListView_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="15" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding PartnerType}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding PartnerName}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DirectorName}" FontSize="13" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Phone}" FontSize="13" Margin="0,2,0,0"/>
                                <TextBlock FontSize="13" Margin="0,2,0,0">
                                    <Run Text="Рейтинг: "/>
                                    <Run Text="{Binding Rating}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,15,0">
                                <Run Text="{Binding Discount}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button x:Name="AddPartnerButton"
                Content="Добавить партнера"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Padding="20,8"
                Background="White"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="AddPartnerButton_Click"/>
    </Grid>
</Window>
