<Window x:Class="_2Modul.PartnerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2Modul"
        mc:Ignorable="d"
        Title="Партнер" Height="560" Width="500"
        Icon="Images/Мастер пол.ico"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Image Source="Images/Мастер пол.png" Width="40" Height="40" Margin="0,0,10,0"/>
            <TextBlock x:Name="HeaderTextBlock" Text="Добавление партнера" FontSize="20"  VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="1" Padding="15">
            <StackPanel>
                <TextBlock Text="Наименование партнера:" Margin="0,0,0,3"/>
                <TextBox x:Name="NameTextBox" Height="26" Margin="0,0,0,10" ToolTip="Введите название компании партнера"/>

                <TextBlock Text="Тип партнера:" Margin="0,0,0,3"/>
                <ComboBox x:Name="TypeComboBox" DisplayMemberPath="TypeName" SelectedValuePath="IDType" Height="26" Margin="0,0,0,10"/>

                <TextBlock Text="Рейтинг:" Margin="0,0,0,3"/>
                <TextBox x:Name="RatingTextBox" Height="26" Margin="0,0,0,10" ToolTip="Введите целое неотрицательное число (например, 0 или 10)"/>

                <TextBlock Text="Адрес:" Margin="0,0,0,3"/>
                <TextBox x:Name="AddressTextBox" Height="26" Margin="0,0,0,10"/>

                <TextBlock Text="ФИО директора:" Margin="0,0,0,3"/>
                <TextBox x:Name="DirectorTextBox" Height="26" Margin="0,0,0,10"/>

                <TextBlock Text="Телефон:" Margin="0,0,0,3"/>
                <TextBox x:Name="PhoneTextBox" Height="26" Margin="0,0,0,10"/>

                <TextBlock Text="Email компании:" Margin="0,0,0,3"/>
                <TextBox x:Name="EmailTextBox" Height="26"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BackButton" Content="Назад" Width="100" Height="32" Margin="0,0,10,0" Click="BackButton_Click"/>
            <Button x:Name="SaveButton" Content="Сохранить" Width="120" Height="32" Background="White" Foreground="Black"  Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
